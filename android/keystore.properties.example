# Copy to keystore.properties (git-ignored). Generate the key ONCE and back it up offline:
#   keytool -genkeypair -v -keystore ~/hymns-release.jks -alias hymns -keyalg RSA -keysize 4096 -validity 10000
# Use Play App Signing: Google holds the app-signing key; this is only your upload key.
storeFile=/absolute/path/to/hymns-release.jks
storePassword=CHANGE_ME
keyAlias=hymns
keyPassword=CHANGE_ME
